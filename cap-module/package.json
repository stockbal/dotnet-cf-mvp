{
  "name": "cap-module",
  "version": "1.0.0",
  "description": "Proxy service to call .NET API",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^4.2.0",
    "@sap-cloud-sdk/http-client": "^4.2.0",
    "@sap-cloud-sdk/resilience": "^4.2.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "requires": {
      "DOTNET_API": {
        "kind": "rest",
        "[production]": {
          "credentials": {
            "destination": "dotnet-api",
            "forwardAuthToken": true
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "destinations": true
      }
    }
  }
}
