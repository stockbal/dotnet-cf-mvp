{
  "xsappname": "dotnet-cf-mvp",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.TaskMonitor",
      "description": "TaskMonitor"
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "TaskMonitor",
      "description": "Reading Taskqueue",
      "scope-references": ["$XSAPPNAME.TaskMonitor"]
    }
  ],
  "role-collections": [
    {
      "name": "TaskMonitor",
      "description": "Allows reading of Taskqueue",
      "role-template-references": ["$XSAPPNAME.TaskMonitor"]
    }
  ],
  "authorities-inheritance": false,
  "oauth2-configuration": {
    "credential-types": ["binding-secret", "x509"],
    "redirect-uris": [
      "http://localhost:5000/login/callback",
      "https://*.cfapps.*.hana.ondemand.com/**",
      "https://oauth.pstmn.io/v1/callback"
    ]
  }
}
